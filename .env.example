# URL pública do site (usada em sitemap, Open Graph, retorno do Mercado Pago e webhook)
NEXT_PUBLIC_SITE_URL=https://brahimcards.com.br

# --- Supabase -------------------------------------------------------------------
# Sem estas três variáveis o site roda em "modo local" com os dados de .data/demo-db.json.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Painel em modo local (só desenvolvimento, sem Supabase) --------------------
ADMIN_DEMO_PASSWORD=troque-esta-senha

# --- Checkout online (Mercado Pago Checkout Pro) --------------------------------
# O botão "Pagar online" só aparece com ONLINE_CHECKOUT_ENABLED=true e o token definido.
ONLINE_CHECKOUT_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
# Assinatura secreta do webhook (Suas integrações > Webhooks). Obrigatória em produção.
MERCADOPAGO_WEBHOOK_SECRET=
# true = usa o sandbox_init_point (credenciais de teste)
MERCADOPAGO_USE_SANDBOX=false
